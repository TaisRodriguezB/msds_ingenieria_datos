      "focus": true,
      "$$hashKey": "object:10817",
      "text": "val bankText = sc.textFile(\"bank-full.csv\")\ncase class Bank(age:Integer, job:String, marital : String, education : String, balance : Integer)\n\n// split each line, filter out header (starts with \"age\"), and map it into Bank case class\nval bank = bankText.map(s=>s.split(\";\")).filter(s=>s(0)!=\"\\\"age\\\"\").map(\n    s=>Bank(s(0).toInt,\n            s(1).replaceAll(\"\\\"\", \"\"),\n            s(2).replaceAll(\"\\\"\", \"\"),\n            s(3).replaceAll(\"\\\"\", \"\"),\n            s(5).replaceAll(\"\\\"\", \"\").toInt\n        )\n)\n\n// convert to DataFrame and create temporal table\nbank.toDF().registerTempTable(\"bank\")\n",
      "dateUpdated": "2025-02-01T05:20:07+0000",
      "dateFinished": "2025-02-01T05:20:16+0000",
      "dateStarted": "2025-02-01T05:20:07+0000",
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "\u001b[33mwarning: \u001b[0mone deprecation (since 2.0.0); for details, enable `:setting -deprecation' or `:replay -deprecation'\n\u001b[1m\u001b[34mbankText\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.rdd.RDD[String]\u001b[0m = bank-full.csv MapPartitionsRDD[39] at textFile at <console>:28\ndefined class Bank\n\u001b[1m\u001b[34mbank\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.rdd.RDD[Bank]\u001b[0m = MapPartitionsRDD[42] at map at <console>:32\n"
